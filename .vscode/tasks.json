{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install npm dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Next.js app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect git status and remotes",
			"type": "shell",
			"command": "git status --short --branch && git remote -v",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect git status and remotes via cmd",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"git status --short --branch && git remote -v"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect git status and remotes via cmd path",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/c",
				"git status --short --branch && git remote -v"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Review project changes",
			"type": "shell",
			"command": "C:\\Windows\\System32\\cmd.exe",
			"args": [
				"/d",
				"/c",
				"git status --short && git diff -- .vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}